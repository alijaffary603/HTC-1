# Model and advisor backend. Leave unset to use Vite's /api development proxy.
# Production: set to the API Gateway ModelApiUrl output, without a trailing slash.
# VITE_MODEL_API_URL=https://example.execute-api.ca-central-1.amazonaws.com
# Existing account/pathway/postings endpoints remain independently configurable:
# VITE_API_URL=https://your-account-api.example.com

# Google Maps browser key (public; restrict to your site origins and Maps JavaScript API).
# Enable Maps JavaScript API and billing in Google Cloud, then restart Vite.
# VITE_GOOGLE_MAPS_API_KEY=
# Optional production map ID; development uses Google's DEMO_MAP_ID.
# VITE_GOOGLE_MAPS_MAP_ID=
